# start-linkly.cmd generates these three credentials and writes .env automatically.
# For manual setup, copy this file to .env and replace the example credentials.
# For an existing PostgreSQL volume, use its existing password.
# Deleting containers/images does not delete that volume or change its password.
DB_PASSWORD=replace-with-your-database-password
# For manual setup, scripts/generate-secrets.cmd prints the two signing secrets below.
# Keep existing signing secrets to retain valid login and suggestion tokens.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VERIFICATION_SECRET=replace-with-another-random-secret-at-least-32-characters
# Optional for startup and basic shortening; required for AI suggestion/confirmation.
GEMINI_API_KEY=
APP_BASE_URL=http://localhost:8080
