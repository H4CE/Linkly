# Copy to .env for Docker Compose; replace all example values before running.
# For an existing PostgreSQL volume, use its existing password.
DB_PASSWORD=replace-with-your-database-password
# Generate independent random secrets of at least 32 characters each.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VERIFICATION_SECRET=replace-with-another-random-secret-at-least-32-characters
# Optional for startup; required for suggesting and confirming new links.
GEMINI_API_KEY=
APP_BASE_URL=http://localhost:8080
