# Optional local overrides. Defaults live in tracked application.yaml.
# Configure environment variables as described in README.md.
# Copy to application.properties only if you need overrides; never commit secrets.
# This file takes precedence over YAML for matching property names.

spring.datasource.password=${DB_PASSWORD}
app.jwt.secret=${JWT_SECRET}
app.verification.secret=${VERIFICATION_SECRET}
app.gemini.api-key=${GEMINI_API_KEY:}
app.base-url=${APP_BASE_URL:http://localhost:8080}
# Java on Windows + Redis from this project's Compose stack:
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6380}
